# Only used when running the app outside Docker (npm run dev).
# `docker compose up` overrides this to point at the postgres container.
DATABASE_URL=postgresql://savedpocket:savedpocket@localhost:5432/savedpocket
# Optional server-wide fallback. Each user can instead set their own key
# in-app: Settings (gear icon) -> AI integration.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Auth (better-auth) - generate a random secret, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# The Chrome extension authenticates with each user's personal key,
# shown in the dashboard sidebar ("Extension key").

IMAGE_CACHE_DIR=./data/images
